{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportV2",
  "description": "JSON Schema specification for WoW-bot aggregated lab report V2.",
  "type": "object",
  "required": ["schema_version", "meta"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "meta": {
      "type": "object",
      "required": [
        "session_id",
        "mode",
        "started_at",
        "stopped_at",
        "stop_reason",
        "config_snapshot",
        "event_count"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["MOCK", "LAB"]
        },
        "started_at": {
          "type": "string"
        },
        "stopped_at": {
          "type": ["string", "null"]
        },
        "stop_reason": {
          "type": ["string", "null"]
        },
        "config_snapshot": {
          "type": "object"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "perception": {
      "type": "object",
      "required": [
        "source",
        "game_state_count",
        "confidence_mean",
        "known_fields"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "game_state_count": {
          "type": "integer",
          "minimum": 0
        },
        "confidence_mean": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "known_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "actuator_intent_count",
        "actuator_result_count",
        "rejected_count",
        "failed_count",
        "success_count",
        "latency_ms_p50",
        "latency_ms_p95",
        "latency_ms_max",
        "status_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "actuator_intent_count": {
          "type": "integer",
          "minimum": 0
        },
        "actuator_result_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms_p50": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "latency_ms_p95": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "latency_ms_max": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "success": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "reflex": {
      "type": "object",
      "required": [
        "tick_count",
        "mean_tick_period_ms",
        "p99_tick_period_ms",
        "overrun_count",
        "signal_counts",
        "sink_error_count",
        "source_error_count"
      ],
      "additionalProperties": false,
      "properties": {
        "tick_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean_tick_period_ms": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "p99_tick_period_ms": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "overrun_count": {
          "type": "integer",
          "minimum": 0
        },
        "signal_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sink_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "navigation": {
      "type": "object",
      "required": [
        "trip_count",
        "success_count",
        "failure_count",
        "replan_count",
        "segment_count",
        "total_duration_s",
        "mean_trip_duration_s",
        "hard_failure_count",
        "telemetry_sample_count",
        "cpu_percent_p95"
      ],
      "additionalProperties": false,
      "properties": {
        "trip_count": {
          "type": "integer",
          "minimum": 0
        },
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "replan_count": {
          "type": "integer",
          "minimum": 0
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_duration_s": {
          "type": "number",
          "minimum": 0.0
        },
        "mean_trip_duration_s": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "hard_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "telemetry_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_percent_p95": {
          "type": ["number", "null"],
          "minimum": 0.0
        }
      }
    },
    "combat": {
      "type": "object",
      "required": [
        "encounter_count",
        "win_count",
        "loss_count",
        "flee_count",
        "timeout_count",
        "interrupt_attempt_count",
        "interrupt_success_count",
        "defensive_cast_count",
        "mean_encounter_duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "encounter_count": {
          "type": "integer",
          "minimum": 0
        },
        "win_count": {
          "type": "integer",
          "minimum": 0
        },
        "loss_count": {
          "type": "integer",
          "minimum": 0
        },
        "flee_count": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_count": {
          "type": "integer",
          "minimum": 0
        },
        "interrupt_attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "interrupt_success_count": {
          "type": "integer",
          "minimum": 0
        },
        "defensive_cast_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean_encounter_duration_s": {
          "type": ["number", "null"],
          "minimum": 0.0
        }
      }
    },
    "humanizer": {
      "type": "object",
      "required": [
        "action_count",
        "interval_samples_ms",
        "pause_count",
        "pause_duration_ms_mean",
        "miss_click_count",
        "config_snapshot"
      ],
      "additionalProperties": false,
      "properties": {
        "action_count": {
          "type": "integer",
          "minimum": 0
        },
        "interval_samples_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "pause_count": {
          "type": "integer",
          "minimum": 0
        },
        "pause_duration_ms_mean": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "miss_click_count": {
          "type": "integer",
          "minimum": 0
        },
        "config_snapshot": {
          "type": "object"
        }
      }
    },
    "strategist": {
      "type": "object",
      "required": [
        "call_count",
        "success_count",
        "blocked_by_cooldown_count",
        "invalid_json_count",
        "llm_error_count",
        "vocab_rejected_count",
        "prompt_hash_count",
        "unique_prompt_hashes",
        "latency_ms_p50",
        "latency_ms_p95",
        "goal_counts",
        "rejection_reason_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "call_count": {
          "type": "integer",
          "minimum": 0
        },
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_by_cooldown_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_json_count": {
          "type": "integer",
          "minimum": 0
        },
        "llm_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "vocab_rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_hash_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_prompt_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "latency_ms_p50": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "latency_ms_p95": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "goal_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "rejection_reason_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "watchdog": {
      "type": "object",
      "required": [
        "transition_count",
        "final_health_state",
        "transition_timeline",
        "loop_detected_count",
        "shutdown_requested",
        "shutdown_exit_code"
      ],
      "additionalProperties": false,
      "properties": {
        "transition_count": {
          "type": "integer",
          "minimum": 0
        },
        "final_health_state": {
          "type": "string",
          "enum": ["healthy", "degraded", "critical"]
        },
        "transition_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ts", "from", "to", "reason"],
            "additionalProperties": false,
            "properties": {
              "ts": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "loop_detected_count": {
          "type": "integer",
          "minimum": 0
        },
        "shutdown_requested": {
          "type": "boolean"
        },
        "shutdown_exit_code": {
          "type": ["integer", "null"],
          "enum": [0, 1, null]
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "sync_count",
        "nodes_discovered",
        "entities_seen",
        "graph_built_count",
        "node_count",
        "edge_count",
        "load_duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "sync_count": {
          "type": "integer",
          "minimum": 0
        },
        "nodes_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "entities_seen": {
          "type": "integer",
          "minimum": 0
        },
        "graph_built_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "load_duration_ms": {
          "type": ["number", "null"],
          "minimum": 0.0
        }
      }
    }
  }
}
